graph LR
    %% Актори та Генералізація
    Customer((Customer))
    Guest((Guest))
    StoreManager((Store Manager))
    PaymentGW[["Payment Gateway"]]
    NotifSVC[["Notification Service"]]

    Customer -- Generalization --> Guest

    %% Precedents (Use Cases)
    UC1([UC-01: View Catalog & SKU])
    UC2([UC-02: Checkout Order])
    UC3([UC-03: Process Payment])
    UC3a([UC-03a: Pay via Card])
    UC4([UC-04: Cancel Expired Order])
    UC5([UC-05: Apply Promo Code])
    UC6([UC-06: Manage Inventory])

    %% Узагальнення прецедентів
    UC3a -- Generalization --> UC3

    %% Зв'язки Акторов
    Guest --> UC1
    Customer --> UC2
    StoreManager --> UC6
    
    PaymentGW --> UC3a
    UC2 --> NotifSVC

    %% Include & Extend (ПРАВИЛЬНІ НАПРЯМКИ СТРІЛОК)
    UC2 -. "include" .-> UC1
    UC3 -. "extend" .-> UC2
    UC5 -. "extend" .-> UC2
    UC4 -. "extend" .-> UC3
